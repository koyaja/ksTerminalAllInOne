{
  "name": "kstermus",
  "productName": "KSTermus",
  "version": "1.5.1",
  "description": "Client SSH / SFTP avec keychain chiffré, snippets et port forwarding",
  "author": "CYBERISK",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "dist:linux": "electron-builder --linux && sh build/repack-deb.sh"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^5.65.18",
    "diff": "^5.2.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12",
    "pe-library": "2.0.1",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.cyberisk.kstermus",
    "productName": "KSTermus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KSTermus"
    },
    "portable": {
      "artifactName": "KSTermus-portable-${version}.exe"
    },
    "afterPack": "build/after-pack.js",
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon-1024.png",
      "category": "Development",
      "executableName": "kstermus",
      "synopsis": "Client SSH / SFTP avec keychain chiffré",
      "maintainer": "CYBERISK <noreply@kstermus.invalid>",
      "desktop": {
        "entry": {
          "Name": "KSTermus",
          "StartupWMClass": "KSTermus",
          "Keywords": "ssh;sftp;terminal;"
        }
      }
    },
    "appImage": {
      "artifactName": "KSTermus-${version}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "kstermus_${version}_amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "optionalDependencies": {
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15"
  }
}
